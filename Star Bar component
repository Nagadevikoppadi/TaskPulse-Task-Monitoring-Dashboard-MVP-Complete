import React from 'react';

export default function StatsBar({ stats }) {
  if (!stats) return null;

  const items = [
    { label: 'Total', value: stats.total, color: '#7c6dfa' },
    { label: 'Completed', value: stats.completed, color: '#4ecdc4' },
    { label: 'In Progress', value: stats.inProgress, color: '#FF6B35' },
    { label: 'Avg Progress', value: `${stats.avgProgress}%`, color: '#FFE66D' },
  ];

  return (
    <div className="stats-bar">
      {items.map(item => (
        <div key={item.label} className="stats-card">
          <span className="stats-value" style={{ color: item.color }}>{item.value}</span>
          <span className="stats-label">{item.label}</span>
        </div>
      ))}
    </div>
  );
}
